# Copia este archivo a .env.local y llena los valores reales.
# .env.local está en .gitignore y NUNCA debe commitearse.

# Se leen en cada petición del lado del servidor. Cambiar el valor NO
# requiere recompilar: basta con reiniciar (o redesplegar) la app.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor. Bypasea RLS. Nunca con prefijo NEXT_PUBLIC_.
# Hará falta para el cron de recordatorios, no para la app web.
# SUPABASE_SECRET_KEY=sb_secret_...
